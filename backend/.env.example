# Copie para .env para rodar o backend fora do Docker (npm run start:dev).
# Valores de DESENVOLVIMENTO — iguais aos padrões do docker-compose.yml.
# Fora do Docker o banco é acessado pela porta publicada no host (5433);
# dentro da rede do Compose o host é "db" e a porta é 5432.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/portal-documentos?schema=public"
PORT=3001
# Origem do frontend liberada no CORS
CORS_ORIGIN=http://localhost:3000
# Segredo de assinatura do JWT — mínimo 32 caracteres. Valor de DESENVOLVIMENTO: troque fora do ambiente local.
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789
# Opcional — segredo compartilhado com o frontend (mínimo 32 caracteres) para ele repassar o IP
# do cliente ao rate limit. Sem ele, a API ignora o IP repassado. Use o mesmo valor nos dois lados.
# INTERNAL_API_SECRET=dev-only-proxy-secret-change-me-0123456789
