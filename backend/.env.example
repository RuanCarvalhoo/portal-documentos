# Copie para .env para rodar o backend fora do Docker (npm run start:dev).
# Valores de DESENVOLVIMENTO — iguais aos padrões do docker-compose.yml.
# Fora do Docker o banco é acessado pela porta publicada no host (5433);
# dentro da rede do Compose o host é "db" e a porta é 5432.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/portal-documentos?schema=public"
PORT=3001
