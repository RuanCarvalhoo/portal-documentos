// Prisma schema — fonte da verdade do modelo de dados.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // O backend compila para CommonJS (tsconfig nodenext sem "type": "module")
  moduleFormat        = "cjs"
  // Imports sem extensão, como o resto do código CJS (o resolvedor do Jest não mapeia .js -> .ts)
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// Perfis de acesso (ADR 012). A leitura é pública; escrever exige Editor; excluir espaços e
// administrar perfis exige Admin. Conta nova entra como Leitor e um Admin a promove.
enum Role {
  ADMIN  @map("admin")
  EDITOR @map("editor")
  READER @map("reader")

  @@map("user_role")
}

// Convenção: camelCase no código, snake_case no banco (@map / @@map)
// IDs uuid v7: ordenados no tempo → inserções no fim do índice da PK (v4 aleatório espalha páginas do B-tree)
model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(READER)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Duas relações com Page → precisam de nome para o Prisma saber qual FK é qual
  createdPages Page[]        @relation("PageCreatedBy")
  updatedPages Page[]        @relation("PageUpdatedBy")
  pageVersions PageVersion[]
  uploads      Upload[]

  @@map("users")
}

model Space {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  pages Page[]

  @@map("spaces")
}

// Hierarquia por lista de adjacência (parentId): a árvore de um espaço sai em 1 query
// e é montada em memória em O(n). Ver docs/adr/002-modelagem-da-arvore.md
model Page {
  id      String @id @default(uuid(7)) @db.Uuid
  title   String
  content String @default("") @db.Text

  spaceId String @map("space_id") @db.Uuid
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  parentId String? @map("parent_id") @db.Uuid
  parent   Page?   @relation("PageHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children Page[]  @relation("PageHierarchy")

  position Int @default(0)
  // Concorrência otimista: o PATCH envia a versão lida; se não bater → 409
  version  Int @default(1)

  createdById String @map("created_by_id") @db.Uuid
  createdBy   User   @relation("PageCreatedBy", fields: [createdById], references: [id])
  updatedById String @map("updated_by_id") @db.Uuid
  updatedBy   User   @relation("PageUpdatedBy", fields: [updatedById], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  versions PageVersion[]
  tags     PageTag[]

  // Árvore: filtra por espaço, agrupa por pai, ordena por posição. Pelo prefixo à esquerda
  // também serve buscas só por space_id → sem índice separado em space_id.
  @@index([spaceId, parentId, position])
  // O Postgres não indexa FKs sozinho: sem este, cada ON DELETE CASCADE da hierarquia faria
  // seq scan em pages para achar as filhas. (created_by_id/updated_by_id ficam sem índice de
  // propósito: só ajudariam ao excluir usuários, o que não existe — seriam custo em toda escrita.)
  @@index([parentId])
  // Busca por substring (ILIKE '%termo%' / contains insensitive): B-tree não ajuda com curinga
  // à esquerda; trigramas + GIN sim. A extensão pg_trgm é criada na migration (SQL manual).
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "pages_title_trgm_idx")
  @@index([content(ops: raw("gin_trgm_ops"))], type: Gin, map: "pages_content_trgm_idx")
  @@map("pages")
}

// Histórico: o estado anterior de uma página a cada edição de título ou conteúdo. Quem grava é
// um trigger no banco (migration add_page_versions), atômico com o UPDATE: nenhuma escrita da
// aplicação consegue esquecer. Ver docs/adr/007-historico-de-versoes.md
model PageVersion {
  pageId  String @map("page_id") @db.Uuid
  page    Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  // Número que a página tinha antes da edição (o mesmo `version` da concorrência otimista)
  version Int

  title   String
  content String @db.Text

  // Quem escreveu esta versão e quando (o updated_by/updated_at da página naquele momento)
  editedById String   @map("edited_by_id") @db.Uuid
  editedBy   User     @relation(fields: [editedById], references: [id])
  editedAt   DateTime @map("edited_at") @db.Timestamptz(3)

  // PK natural: uma versão por número em cada página; também serve à listagem por página
  @@id([pageId, version])
  @@map("page_versions")
}

// Tags (ADR 011): classificação que atravessa os espaços. O nome já chega normalizado
// (minúsculas, hífens no lugar de espaços), então o unique dispensa comparação sem caixa.
model Tag {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  pages PageTag[]

  @@map("tags")
}

// N:N entre páginas e tags. A PK (page_id, tag_id) atende "tags da página" e o índice em
// tag_id atende "páginas da tag" (e o cascade quando uma tag é excluída).
model PageTag {
  pageId String @map("page_id") @db.Uuid
  page   Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  tagId  String @map("tag_id") @db.Uuid
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([pageId, tagId])
  @@index([tagId])
  @@map("page_tags")
}

// Imagens enviadas pelo editor (ADR 010), guardadas no próprio Postgres (bytea): o "um comando"
// continua sem infraestrutura extra e qualquer réplica da API serve qualquer imagem. O sha256
// é único: o mesmo arquivo enviado de novo reaproveita o registro (e vira o ETag da resposta).
model Upload {
  id           String   @id @default(uuid(7)) @db.Uuid
  fileName     String   @map("file_name")
  mimeType     String   @map("mime_type")
  size         Int
  sha256       String   @unique @db.Char(64)
  data         Bytes
  uploadedById String   @map("uploaded_by_id") @db.Uuid
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("uploads")
}
